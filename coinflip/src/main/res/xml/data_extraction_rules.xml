<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
  <cloud-backup>
    <include
      domain="sharedpref"
      path="." />
    <!-- the custom coin's artwork, so a restored device keeps the coin its prefs still name -->
    <include
      domain="file"
      path="coins" />
  </cloud-backup>
  <device-transfer>
    <include
      domain="sharedpref"
      path="." />
    <!-- the custom coin's artwork, so a restored device keeps the coin its prefs still name -->
    <include
      domain="file"
      path="coins" />
  </device-transfer>
</data-extraction-rules>