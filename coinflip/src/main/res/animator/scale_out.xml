<?xml version="1.0" encoding="utf-8"?>
<!-- scale is unitless, so unlike slide_x this needs no help from the fragment: there is no distance
     to measure against a window whose width the resource cannot know. It shrinks about the view's
     own centre, which is what reads as receding rather than sliding -->
<set xmlns:android="http://schemas.android.com/apk/res/android">
  <objectAnimator
    android:duration="@integer/nav_anim_duration"
    android:propertyName="scaleX"
    android:valueFrom="@dimen/nav_scale_full"
    android:valueTo="@dimen/nav_scale_collapsed"
    android:valueType="floatType"
    />
  <objectAnimator
    android:duration="@integer/nav_anim_duration"
    android:propertyName="scaleY"
    android:valueFrom="@dimen/nav_scale_full"
    android:valueTo="@dimen/nav_scale_collapsed"
    android:valueType="floatType"
    />
  <objectAnimator
    android:duration="@integer/nav_anim_duration"
    android:propertyName="alpha"
    android:valueFrom="@dimen/nav_alpha_visible"
    android:valueTo="@dimen/nav_alpha_hidden"
    android:valueType="floatType"
    />
</set>
